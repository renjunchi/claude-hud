{
  "name": "cli-hud",
  "version": "0.2.0",
  "description": "Terminal HUD for Claude Code with an OpenAI Codex rollout adapter",
  "type": "module",
  "bin": {
    "cli-hud": "dist/cli-hud.js"
  },
  "scripts": {
